# Para rodar os TESTES (ou o app) fora do Docker. Copie para .env: o Bun carrega sozinho.
# Banco e filas EXCLUSIVOS dos testes, para não disputar dados/mensagens com o container `app`:
#  - banco `wagering_test` (criado por postgres/init/ na criação do volume);
#  - conta 111111111111 do MiniStack (access key de 12 dígitos = conta AWS isolada, com filas próprias).
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/wagering_test
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=111111111111
AWS_SECRET_ACCESS_KEY=test
